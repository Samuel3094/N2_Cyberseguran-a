# ---------- Servidor ----------
NODE_ENV=development
PORT=4000
# Origens permitidas no CORS (separadas por vírgula). Ex.: https://seuusuario.github.io
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Banco de dados ----------
# Recomendado (requisito 2b): MongoDB Atlas em nuvem
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/assinaturas?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/assinaturas

# ---------- Segredos (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
CSRF_SECRET=troque-por-outro-segredo-longo-e-aleatorio
# Protege a chave privada do carimbo de tempo do servidor (AES-256-GCM)
SERVER_KEY_SECRET=troque-por-um-terceiro-segredo-longo
JWT_EXPIRES_IN=1h

# ---------- Usuário gerente inicial (criado se o banco estiver vazio) ----------
ADMIN_NAME=Gerente Administrador
ADMIN_EMAIL=gerente@empresa.com
ADMIN_PASSWORD=Gerente@2026!

# ---------- E-mail (Nodemailer) ----------
# Sem SMTP_HOST os e-mails são apenas exibidos no console (modo de desenvolvimento).
# Para testes use https://ethereal.email ou uma senha de app do Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Assinatura Digital <no-reply@empresa.com>"
# URL pública do frontend (usada nos links dos e-mails)
FRONTEND_URL=http://localhost:3000
